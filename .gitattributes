# Handle text files automatically and normalize them to LF on check-in
* text=auto eol=lf

# Explicitly ensure common text-based files use LF
*.txt text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf

# Denote files that are truly binary and should not be modified
*.png binary
*.jpg binary
